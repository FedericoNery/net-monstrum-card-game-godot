[gd_scene load_steps=2 format=3]

[ext_resource type="Script" path="res://scenes/ui/network_lobby.gd" id="1_script"]

[node name="NetworkLobby" type="Control"]
layout_mode = 3
anchors_preset = 0
offset_left = 40.0
offset_top = 40.0
offset_right = 500.0
offset_bottom = 220.0
script = ExtResource("1_script")

[node name="VBox" type="VBoxContainer" parent="."]
layout_mode = 2

[node name="HostButton" type="Button" parent="VBox"]
layout_mode = 2
text = "Hostear partida"

[node name="IpRow" type="HBoxContainer" parent="VBox"]
layout_mode = 2

[node name="IpInput" type="LineEdit" parent="VBox/IpRow"]
layout_mode = 2
size_flags_horizontal = 3
placeholder_text = "127.0.0.1"

[node name="ConnectButton" type="Button" parent="VBox/IpRow"]
layout_mode = 2
text = "Conectar"

[node name="StatusLabel" type="Label" parent="VBox"]
layout_mode = 2
text = "Sin conectar."
autowrap_mode = 2

[connection signal="pressed" from="VBox/HostButton" to="." method="_on_host_pressed"]
[connection signal="pressed" from="VBox/IpRow/ConnectButton" to="." method="_on_connect_pressed"]
