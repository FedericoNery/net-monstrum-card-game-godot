[gd_scene load_steps=3 format=3]

[ext_resource type="Script" path="res://scenes/tests/test_resource_counter.gd" id="1_script"]
[ext_resource type="PackedScene" path="res://scenes/ui/resource_counter.tscn" id="2_counter"]

[node name="TestResourceCounter" type="Node2D"]
script = ExtResource("1_script")

[node name="Info" type="Label" parent="."]
offset_left = 40.0
offset_top = 40.0
offset_right = 900.0
offset_bottom = 90.0
text = "Test aislado de ResourceCounter (energía, mano, mazo) con botones +1/-1."

[node name="UI" type="CanvasLayer" parent="."]

[node name="VBox" type="VBoxContainer" parent="UI"]
offset_left = 40.0
offset_top = 120.0
offset_right = 500.0
offset_bottom = 300.0

[node name="Row1" type="HBoxContainer" parent="UI/VBox"]

[node name="EnergyRed" parent="UI/VBox/Row1" instance=ExtResource("2_counter")]
swatch_color = Color(1, 0, 0, 1)

[node name="ButtonPlus" type="Button" parent="UI/VBox/Row1"]
text = "+1"

[node name="ButtonMinus" type="Button" parent="UI/VBox/Row1"]
text = "-1"

[node name="Row2" type="HBoxContainer" parent="UI/VBox"]

[node name="HandCounter" parent="UI/VBox/Row2" instance=ExtResource("2_counter")]
title_text = "Mano"

[node name="ButtonPlus" type="Button" parent="UI/VBox/Row2"]
text = "+1"

[node name="ButtonMinus" type="Button" parent="UI/VBox/Row2"]
text = "-1"

[node name="Row3" type="HBoxContainer" parent="UI/VBox"]

[node name="DeckCounter" parent="UI/VBox/Row3" instance=ExtResource("2_counter")]
title_text = "Mazo"

[node name="ButtonPlus" type="Button" parent="UI/VBox/Row3"]
text = "+1"

[node name="ButtonMinus" type="Button" parent="UI/VBox/Row3"]
text = "-1"

[connection signal="pressed" from="UI/VBox/Row1/ButtonPlus" to="." method="_on_energy_plus_pressed"]
[connection signal="pressed" from="UI/VBox/Row1/ButtonMinus" to="." method="_on_energy_minus_pressed"]
[connection signal="pressed" from="UI/VBox/Row2/ButtonPlus" to="." method="_on_hand_plus_pressed"]
[connection signal="pressed" from="UI/VBox/Row2/ButtonMinus" to="." method="_on_hand_minus_pressed"]
[connection signal="pressed" from="UI/VBox/Row3/ButtonPlus" to="." method="_on_deck_plus_pressed"]
[connection signal="pressed" from="UI/VBox/Row3/ButtonMinus" to="." method="_on_deck_minus_pressed"]
