[gd_scene load_steps=3 format=3]

[ext_resource type="Script" path="res://scenes/tests/test_phase_banner.gd" id="1_script"]
[ext_resource type="PackedScene" path="res://scenes/ui/phase_banner.tscn" id="2_banner"]

[node name="TestPhaseBanner" type="Node2D"]
script = ExtResource("1_script")

[node name="Info" type="Label" parent="."]
offset_left = 40.0
offset_top = 40.0
offset_right = 900.0
offset_bottom = 90.0
text = "Test aislado de PhaseBanner: un botón por fase."

[node name="PhaseBanner" parent="." instance=ExtResource("2_banner")]

[node name="UI" type="CanvasLayer" parent="."]

[node name="VBox" type="VBoxContainer" parent="UI"]
offset_left = 40.0
offset_top = 400.0
offset_right = 300.0
offset_bottom = 650.0

[node name="ButtonStart" type="Button" parent="UI/VBox"]
text = "Start Phase"

[node name="ButtonDraw" type="Button" parent="UI/VBox"]
text = "Draw Phase"

[node name="ButtonLoad" type="Button" parent="UI/VBox"]
text = "Load Phase"

[node name="ButtonSummon" type="Button" parent="UI/VBox"]
text = "Summon Phase"

[node name="ButtonCompile" type="Button" parent="UI/VBox"]
text = "Compile Phase"

[node name="ButtonBattle" type="Button" parent="UI/VBox"]
text = "Battle Phase"

[node name="StatusLabel" type="Label" parent="UI/VBox"]
text = "Última fase mostrada: (ninguna)"

[connection signal="pressed" from="UI/VBox/ButtonStart" to="." method="_on_start_pressed"]
[connection signal="pressed" from="UI/VBox/ButtonDraw" to="." method="_on_draw_pressed"]
[connection signal="pressed" from="UI/VBox/ButtonLoad" to="." method="_on_load_pressed"]
[connection signal="pressed" from="UI/VBox/ButtonSummon" to="." method="_on_summon_pressed"]
[connection signal="pressed" from="UI/VBox/ButtonCompile" to="." method="_on_compile_pressed"]
[connection signal="pressed" from="UI/VBox/ButtonBattle" to="." method="_on_battle_pressed"]
